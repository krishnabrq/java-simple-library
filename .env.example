# Template for .env — copy to `.env` and fill in real values.
# Spring Boot reads `.env` via `spring.config.import=optional:file:./.env[.properties]`.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library
DB_USER=postgres
DB_PASSWORD=changeme

# --- JPA / Hibernate ---
# create-drop | update | validate | none
DB_DDL_AUTO=update
DB_SHOW_SQL=true

# --- Logging ---
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
# Structured log format: empty (human-readable) | ecs | gelf | logstash
LOG_STRUCTURED_FORMAT=
