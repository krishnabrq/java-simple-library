# Template for .env — copy to `.env` and fill in real values.
# Spring Boot reads `.env` via `spring.config.import=optional:file:./.env[.properties]`.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library
DB_USER=postgres
DB_PASSWORD=changeme

# --- JPA / Hibernate ---
# create-drop | update | validate | none
DB_DDL_AUTO=update
DB_SHOW_SQL=true

# --- Logging ---
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
# Structured log format: empty (human-readable) | ecs | gelf | logstash
LOG_STRUCTURED_FORMAT=

# --- Auth (JWT, HS256) ---
# Secret MUST be at least 32 bytes (256 bits). Generate with:
#   openssl rand -base64 32
JWT_SECRET=replace-me-with-output-of-openssl-rand-base64-32
# ISO-8601 durations.
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
